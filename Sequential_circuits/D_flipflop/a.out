#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_000001D036DE5010 .scope module, "tb_d_flipflop" "tb_d_flipflop" 2 3;
 .timescale -9 -12;
v000001D036DE5790_0 .var "CLK", 0 0;
v000001D036DBC700_0 .var "D", 0 0;
v000001D036DBC7A0_0 .net "Q", 0 0, v000001D036DE5650_0;  1 drivers
v000001D036DBC840_0 .net "Qbar", 0 0, v000001D036DE56F0_0;  1 drivers
S_000001D036DE53B0 .scope module, "uut" "d_flipflop" 2 12, 3 1 0, S_000001D036DE5010;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "CLK";
    .port_info 2 /OUTPUT 1 "Q";
    .port_info 3 /OUTPUT 1 "Qbar";
v000001D036DE55B0_0 .net "CLK", 0 0, v000001D036DE5790_0;  1 drivers
v000001D036DF94B0_0 .net "D", 0 0, v000001D036DBC700_0;  1 drivers
v000001D036DE5650_0 .var "Q", 0 0;
v000001D036DE56F0_0 .var "Qbar", 0 0;
E_000001D036DE1EB0 .event posedge, v000001D036DE55B0_0;
    .scope S_000001D036DE53B0;
T_0 ;
    %wait E_000001D036DE1EB0;
    %load/vec4 v000001D036DF94B0_0;
    %assign/vec4 v000001D036DE5650_0, 0;
    %load/vec4 v000001D036DF94B0_0;
    %inv;
    %assign/vec4 v000001D036DE56F0_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_000001D036DE5010;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D036DE5790_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v000001D036DE5790_0;
    %inv;
    %store/vec4 v000001D036DE5790_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_000001D036DE5010;
T_2 ;
    %vpi_call 2 30 "$dumpfile", "d_flipflop.vcd" {0 0 0};
    %vpi_call 2 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001D036DE5010 {0 0 0};
    %vpi_call 2 33 "$monitor", "Time=%0t | CLK=%b D=%b | Q=%b Qbar=%b", $time, v000001D036DE5790_0, v000001D036DBC700_0, v000001D036DBC7A0_0, v000001D036DBC840_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D036DBC700_0, 0, 1;
    %delay 12000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D036DBC700_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D036DBC700_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001D036DBC700_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001D036DBC700_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 61 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "module.v";
