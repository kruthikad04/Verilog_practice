v00000291F1734530_0 .net "a", 0 0, v00000291F1734A10_0;  1 drivers
v00000291F170C8E0_0 .net "b", 0 0, v00000291F1734AB0_0;  1 drivers
v00000291F1733D50_0 .net "out", 0 0, L_00000291F1733DF0;  alias, 1 drivers
    .scope S_00000291F17343A0;
T_0 ;
    %vpi_call 2 20 "$monitor", "Time = %0t ns | Input A = %b | Input B = %b | Output OUT = %b", $time, v00000291F1734A10_0, v00000291F1734AB0_0, v00000291F1747370_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_00000291F17343A0;
