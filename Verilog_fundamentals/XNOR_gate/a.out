v000002C6A6492F50_0 .net "a", 0 0, v000002C6A64933B0_0;  1 drivers
v000002C6A646C620_0 .net "b", 0 0, v000002C6A6493450_0;  1 drivers
v000002C6A6492770_0 .net "out", 0 0, L_000002C6A64934F0;  alias, 1 drivers
    .scope S_000002C6A6492DC0;
T_0 ;
    %vpi_call 2 20 "$monitor", "Time = %0t ns | Input A = %b | Input B = %b | Output OUT = %b", $time, v000002C6A64933B0_0, v000002C6A6493450_0, v000002C6A64EE840_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_000002C6A6492DC0;
