    %store/vec4 v00000291F1734A10_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000291F1734AB0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000291F1734A10_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000291F1734AB0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000291F1734A10_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000291F1734AB0_0, 0, 1;
