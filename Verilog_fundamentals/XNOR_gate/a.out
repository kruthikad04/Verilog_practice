    %store/vec4 v000002C6A64933B0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002C6A6493450_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002C6A64933B0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002C6A6493450_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002C6A64933B0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002C6A6493450_0, 0, 1;
