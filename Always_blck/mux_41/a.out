S_000001B13B661FD0 .scope module, "mux4to1_tb" "mux4to1_tb" 2 3;
 .timescale -9 -12;
v000001B13B63BFF0_0 .var "I", 3 0;
v000001B13B63C090_0 .var "S", 1 0;
v000001B13B63C130_0 .net "Y", 0 0, v000001B13B661D90_0;  1 drivers
