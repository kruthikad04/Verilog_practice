    %vpi_call 2 29 "$dumpvars", 32'sb00000000000000000000000000000000, S_000002691F9A4160 {0 0 0};
    %vpi_call 2 31 "$monitor", "Time=%0t | CLK=%b T=%b | Q=%b", $time, v000002691F9A47D0_0, v000002691F97C3B0_0, v000002691F97C310_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002691F97C3B0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002691F97C3B0_0, 0, 1;
