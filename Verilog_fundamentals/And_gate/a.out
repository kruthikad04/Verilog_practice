#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_0000027EBC6A4480 .scope module, "tb_and_gate" "tb_and_gate" 2 3;
 .timescale -9 -12;
v0000027EBC6B83C0_0 .var "a", 0 0;
v0000027EBC6B8460_0 .var "b", 0 0;
v0000027EBC6B8500_0 .net "y", 0 0, L_0000027EBC6A3F70;  1 drivers
S_0000027EBC6B8190 .scope module, "uut" "and_gate_dataflow" 2 12, 3 1 0, S_0000027EBC6A4480;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0000027EBC6A3F70 .functor AND 1, v0000027EBC6B83C0_0, v0000027EBC6B8460_0, C4<1>, C4<1>;
v0000027EBC6A3ED0_0 .net "a", 0 0, v0000027EBC6B83C0_0;  1 drivers
v0000027EBC67CC20_0 .net "b", 0 0, v0000027EBC6B8460_0;  1 drivers
v0000027EBC6B8320_0 .net "y", 0 0, L_0000027EBC6A3F70;  alias, 1 drivers
    .scope S_0000027EBC6A4480;
T_0 ;
    %vpi_call 2 21 "$dumpfile", "and_wave.vcd" {0 0 0};
    %vpi_call 2 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0000027EBC6A4480 {0 0 0};
    %vpi_call 2 25 "$monitor", "Time=%0td | Inputs: a=%b, b=%b | Output: y=%b", $time, v0000027EBC6B83C0_0, v0000027EBC6B8460_0, v0000027EBC6B8500_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000027EBC6B83C0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000027EBC6B8460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000027EBC6B83C0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000027EBC6B8460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000027EBC6B83C0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000027EBC6B8460_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000027EBC6B83C0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000027EBC6B8460_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 34 "$finish" {0 0 0};
    %end;
    .thread T_0;
