v000001B13B679A40_0 .net "S", 1 0, v000001B13B63C090_0;  1 drivers
v000001B13B661D90_0 .var "Y", 0 0;
E_000001B13B67B430 .event anyedge, v000001B13B679A40_0, v000001B13B661CF0_0;
    .scope S_000001B13B662160;
T_0 ;
    %wait E_000001B13B67B430;
    %load/vec4 v000001B13B679A40_0;
    %dup/vec4;
    %pushi/vec4 0, 0, 2;
    %cmp/e;
    %jmp/1 T_0.0, 6;
    %dup/vec4;
    %pushi/vec4 1, 0, 2;
    %cmp/e;
    %jmp/1 T_0.1, 6;
    %dup/vec4;
    %pushi/vec4 2, 0, 2;
    %cmp/e;
    %jmp/1 T_0.2, 6;
    %dup/vec4;
    %pushi/vec4 3, 0, 2;
    %cmp/e;
    %jmp/1 T_0.3, 6;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001B13B661D90_0, 0, 1;
    %jmp T_0.5;
T_0.0 ;
    %load/vec4 v000001B13B661CF0_0;
    %parti/s 1, 0, 2;
    %store/vec4 v000001B13B661D90_0, 0, 1;
    %jmp T_0.5;
T_0.1 ;
    %load/vec4 v000001B13B661CF0_0;
    %parti/s 1, 1, 2;
    %store/vec4 v000001B13B661D90_0, 0, 1;
    %jmp T_0.5;
T_0.2 ;
    %load/vec4 v000001B13B661CF0_0;
    %parti/s 1, 2, 3;
    %store/vec4 v000001B13B661D90_0, 0, 1;
    %jmp T_0.5;
T_0.3 ;
    %load/vec4 v000001B13B661CF0_0;
    %parti/s 1, 3, 3;
    %store/vec4 v000001B13B661D90_0, 0, 1;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001B13B661FD0;
T_1 ;
    %vpi_call 2 20 "$dumpfile", "mux4to1.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001B13B661FD0 {0 0 0};
    %vpi_call 2 23 "$monitor", "Time=%0t | I=%b | S=%b | Y=%b", $time, v000001B13B63BFF0_0, v000001B13B63C090_0, v000001B13B63C130_0 {0 0 0};
    %pushi/vec4 10, 0, 4;
