    %vpi_call 2 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001FAF1614450 {0 0 0};
    %vpi_call 2 25 "$monitor", "Time = %0t ns | Input: a = %b, b = %b | Output: diff = %b, borrow = %b", $time, v000001FAF1614680_0, v000001FAF166E890_0, v000001FAF166F6F0_0, v000001FAF166E930_0 {0 0 0};
