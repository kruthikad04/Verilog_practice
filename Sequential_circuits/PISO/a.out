S_000001DE9A019B10 .scope module, "tb_piso" "tb_piso" 2 3;
 .timescale -9 -12;
v000001DE9A015E00_0 .var "clk", 0 0;
v000001DE9A015EA0_0 .var "d", 3 0;
v000001DE9A015F40_0 .var "load", 0 0;
v000001DE9A0617C0_0 .var "reset", 0 0;
v000001DE9A0612C0_0 .net "serial_out", 0 0, L_000001DE9A061A40;  1 drivers
S_000001DE9A019CA0 .scope module, "uut" "piso" 2 11, 3 1 0, S_000001DE9A019B10;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "load";
    .port_info 3 /INPUT 4 "d";
    .port_info 4 /OUTPUT 1 "serial_out";
v000001DE9A002960_0 .net "clk", 0 0, v000001DE9A015E00_0;  1 drivers
v000001DE99FDCA80_0 .net "d", 3 0, v000001DE9A015EA0_0;  1 drivers
v000001DE9A019E30_0 .net "load", 0 0, v000001DE9A015F40_0;  1 drivers
v000001DE9A019ED0_0 .var "q", 3 0;
v000001DE9A015CC0_0 .net "reset", 0 0, v000001DE9A0617C0_0;  1 drivers
v000001DE9A015D60_0 .net "serial_out", 0 0, L_000001DE9A061A40;  alias, 1 drivers
E_000001DE9A01B0C0 .event posedge, v000001DE9A015CC0_0, v000001DE9A002960_0;
L_000001DE9A061A40 .part v000001DE9A019ED0_0, 3, 1;
    .scope S_000001DE9A019CA0;
T_0 ;
    %wait E_000001DE9A01B0C0;
    %load/vec4 v000001DE9A015CC0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 4;
    %assign/vec4 v000001DE9A019ED0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v000001DE9A019E30_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v000001DE99FDCA80_0;
    %assign/vec4 v000001DE9A019ED0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v000001DE9A019ED0_0;
    %parti/s 3, 0, 2;
    %concati/vec4 0, 0, 1;
    %assign/vec4 v000001DE9A019ED0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_000001DE9A019B10;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v000001DE9A015E00_0;
    %inv;
    %store/vec4 v000001DE9A015E00_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_000001DE9A019B10;
T_2 ;
    %vpi_call 2 24 "$dumpfile", "piso.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001DE9A019B10 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001DE9A015E00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001DE9A0617C0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001DE9A015F40_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v000001DE9A015EA0_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001DE9A0617C0_0, 0, 1;
    %delay 2000, 0;
    %pushi/vec4 11, 0, 4;
    %store/vec4 v000001DE9A015EA0_0, 0, 4;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001DE9A015F40_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001DE9A015F40_0, 0, 1;
    %delay 40000, 0;
    %vpi_call 2 46 "$finish" {0 0 0};
