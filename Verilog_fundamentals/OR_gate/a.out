#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_00000274D4944360 .scope module, "tb_or_gate" "tb_or_gate" 2 3;
 .timescale -9 -12;
v00000274D495CC80_0 .var "a", 0 0;
v00000274D491E4F0_0 .var "b", 0 0;
v00000274D491E590_0 .net "y", 0 0, L_00000274D491E630;  1 drivers
S_00000274D49444F0 .scope module, "uut" "or_gate_dataflow" 2 11, 3 1 0, S_00000274D4944360;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_00000274D491E630 .functor OR 1, v00000274D495CC80_0, v00000274D491E4F0_0, C4<0>, C4<0>;
v00000274D495CEC0_0 .net "a", 0 0, v00000274D495CC80_0;  1 drivers
v00000274D495C590_0 .net "b", 0 0, v00000274D491E4F0_0;  1 drivers
v00000274D495CBE0_0 .net "y", 0 0, L_00000274D491E630;  alias, 1 drivers
    .scope S_00000274D4944360;
T_0 ;
    %vpi_call 2 20 "$dumpfile", "or_wave.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_00000274D4944360 {0 0 0};
    %vpi_call 2 24 "$monitor", "Time=%0td | Inputs: a=%b, b=%b | Output: y=%b", $time, v00000274D495CC80_0, v00000274D491E4F0_0, v00000274D491E590_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000274D495CC80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000274D491E4F0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000274D495CC80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000274D491E4F0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000274D495CC80_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000274D491E4F0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000274D495CC80_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000274D491E4F0_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 33 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "module.v";
