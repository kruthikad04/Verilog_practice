#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_00000253CDA14A30 .scope module, "gray_to_binary_tb" "gray_to_binary_tb" 2 3;
 .timescale -9 -12;
v00000253CDA295D0_0 .net "binary", 3 0, v00000253CDA14BC0_0;  1 drivers
v00000253CDA15060_0 .var "gray", 3 0;
S_00000253CDA14ED0 .scope module, "uut" "gray_to_binary" 2 9, 3 1 0, S_00000253CDA14A30;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "gray";
    .port_info 1 /OUTPUT 4 "binary";
v00000253CDA14BC0_0 .var "binary", 3 0;
v00000253CD9EC410_0 .net "gray", 3 0, v00000253CDA15060_0;  1 drivers
E_00000253CDA14630 .event anyedge, v00000253CD9EC410_0, v00000253CDA14BC0_0;
    .scope S_00000253CDA14ED0;
T_0 ;
    %wait E_00000253CDA14630;
    %load/vec4 v00000253CD9EC410_0;
    %parti/s 1, 3, 3;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v00000253CDA14BC0_0, 4, 1;
    %load/vec4 v00000253CDA14BC0_0;
    %parti/s 1, 3, 3;
    %load/vec4 v00000253CD9EC410_0;
    %parti/s 1, 2, 3;
    %xor;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v00000253CDA14BC0_0, 4, 1;
    %load/vec4 v00000253CDA14BC0_0;
    %parti/s 1, 2, 3;
    %load/vec4 v00000253CD9EC410_0;
    %parti/s 1, 1, 2;
    %xor;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v00000253CDA14BC0_0, 4, 1;
    %load/vec4 v00000253CDA14BC0_0;
    %parti/s 1, 1, 2;
    %load/vec4 v00000253CD9EC410_0;
    %parti/s 1, 0, 2;
    %xor;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v00000253CDA14BC0_0, 4, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_00000253CDA14A30;
T_1 ;
    %vpi_call 2 17 "$dumpfile", "gray_to_binary.vcd" {0 0 0};
    %vpi_call 2 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_00000253CDA14A30 {0 0 0};
    %vpi_call 2 20 "$monitor", "Time=%0t | Gray=%b | Binary=%b (%0d)", $time, v00000253CDA15060_0, v00000253CDA295D0_0, v00000253CDA295D0_0 {0 0 0};
    %pushi/vec4 0, 0, 4;
    %store/vec4 v00000253CDA15060_0, 0, 4;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v00000253CDA15060_0, 0, 4;
    %delay 10000, 0;
