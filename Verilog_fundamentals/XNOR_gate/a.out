S_000002C6A6492DC0 .scope module, "tb_xnor_gate" "tb_xnor_gate" 2 3;
 .timescale -9 -12;
v000002C6A64933B0_0 .var "a", 0 0;
v000002C6A6493450_0 .var "b", 0 0;
v000002C6A64EE840_0 .net "out", 0 0, L_000002C6A64934F0;  1 drivers
