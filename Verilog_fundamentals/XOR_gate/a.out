S_00000291F17343A0 .scope module, "tb_xor_gate_df" "tb_xor_gate_df" 2 3;
 .timescale -9 -12;
v00000291F1734A10_0 .var "a", 0 0;
v00000291F1734AB0_0 .var "b", 0 0;
