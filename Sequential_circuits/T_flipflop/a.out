    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002691F97C3B0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000002691F97C3B0_0, 0, 1;
