#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_00000177FCC148C0 .scope module, "half_adder_tb" "half_adder_tb" 2 3;
 .timescale -9 -12;
v00000177FCC14E60_0 .var "a", 0 0;
v00000177FCC14F00_0 .var "b", 0 0;
v00000177FCC14FA0_0 .net "carry", 0 0, L_00000177FCC15490;  1 drivers
v00000177FCC15380_0 .net "sum", 0 0, L_00000177FCC15420;  1 drivers
S_00000177FCC144E0 .scope module, "uut" "half_adder" 2 10, 3 2 0, S_00000177FCC148C0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_00000177FCC15420 .functor XOR 1, v00000177FCC14E60_0, v00000177FCC14F00_0, C4<0>, C4<0>;
L_00000177FCC15490 .functor AND 1, v00000177FCC14E60_0, v00000177FCC14F00_0, C4<1>, C4<1>;
v00000177FCC14670_0 .net "a", 0 0, v00000177FCC14E60_0;  1 drivers
v00000177FCC28F80_0 .net "b", 0 0, v00000177FCC14F00_0;  1 drivers
v00000177FCC14D20_0 .net "carry", 0 0, L_00000177FCC15490;  alias, 1 drivers
v00000177FCC14DC0_0 .net "sum", 0 0, L_00000177FCC15420;  alias, 1 drivers
    .scope S_00000177FCC148C0;
T_0 ;
    %vpi_call 2 19 "$dumpfile", "half_adder_tb.vcd" {0 0 0};
    %vpi_call 2 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_00000177FCC148C0 {0 0 0};
    %vpi_call 2 23 "$display", "Time\011 A \011 B \011 Sum \011 Carry" {0 0 0};
    %vpi_call 2 24 "$monitor", "%0t\011 %b \011 %b \011  %b  \011   %b", $time, v00000177FCC14E60_0, v00000177FCC14F00_0, v00000177FCC15380_0, v00000177FCC14FA0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000177FCC14E60_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000177FCC14F00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000177FCC14E60_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000177FCC14F00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000177FCC14E60_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000177FCC14F00_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000177FCC14E60_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000177FCC14F00_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 33 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "module.v";
