#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_000001A207C65770 .scope module, "tb_d_latch" "tb_d_latch" 2 3;
 .timescale -9 -12;
v000001A207C3ED20_0 .var "D", 0 0;
v000001A207C3EDC0_0 .var "EN", 0 0;
v000001A207C3EE60_0 .net "Q", 0 0, v000001A207C65490_0;  1 drivers
v000001A207C3EF00_0 .net "Qbar", 0 0, v000001A207C65530_0;  1 drivers
S_000001A207C65900 .scope module, "uut" "d_latch" 2 12, 3 1 0, S_000001A207C65770;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "EN";
    .port_info 2 /OUTPUT 1 "Q";
    .port_info 3 /OUTPUT 1 "Qbar";
v000001A207C65B00_0 .net "D", 0 0, v000001A207C3ED20_0;  1 drivers
v000001A207C7ADC0_0 .net "EN", 0 0, v000001A207C3EDC0_0;  1 drivers
v000001A207C65490_0 .var "Q", 0 0;
v000001A207C65530_0 .var "Qbar", 0 0;
E_000001A207C67BB0 .event anyedge, v000001A207C7ADC0_0, v000001A207C65B00_0;
    .scope S_000001A207C65900;
T_0 ;
    %wait E_000001A207C67BB0;
    %load/vec4 v000001A207C7ADC0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v000001A207C65B00_0;
    %store/vec4 v000001A207C65490_0, 0, 1;
    %load/vec4 v000001A207C65B00_0;
    %inv;
    %store/vec4 v000001A207C65530_0, 0, 1;
T_0.0 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001A207C65770;
T_1 ;
    %vpi_call 2 22 "$dumpfile", "d_latch.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001A207C65770 {0 0 0};
    %vpi_call 2 25 "$monitor", "Time=%0t | EN=%b D=%b | Q=%b Qbar=%b", $time, v000001A207C3EDC0_0, v000001A207C3ED20_0, v000001A207C3EE60_0, v000001A207C3EF00_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3EDC0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001A207C3EDC0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3EDC0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A207C3ED20_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 60 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "module.v";
