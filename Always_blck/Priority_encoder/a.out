    %store/vec4 v000001A81183AB60_0, 0, 1;
    %load/vec4 v000001A811840C20_0;
    %parti/s 1, 3, 3;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v000001A8117FE260_0, 0, 2;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v000001A811840C20_0;
    %parti/s 1, 2, 3;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.2, 4;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v000001A8117FE260_0, 0, 2;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v000001A811840C20_0;
    %parti/s 1, 1, 2;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.4, 4;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v000001A8117FE260_0, 0, 2;
    %jmp T_0.5;
T_0.4 ;
    %load/vec4 v000001A811840C20_0;
    %parti/s 1, 0, 2;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_0.6, 4;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v000001A8117FE260_0, 0, 2;
    %jmp T_0.7;
T_0.6 ;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v000001A8117FE260_0, 0, 2;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001A81183AB60_0, 0, 1;
T_0.7 ;
T_0.5 ;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001A811840A90;
T_1 ;
    %vpi_call 2 20 "$dumpfile", "priority_encoder.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001A811840A90 {0 0 0};
    %vpi_call 2 23 "$monitor", "Time=%0t | D=%b | Y=%b | Valid=%b", $time, v000001A811824120_0, v000001A8118241C0_0, v000001A811824260_0 {0 0 0};
    %pushi/vec4 1, 0, 4;
