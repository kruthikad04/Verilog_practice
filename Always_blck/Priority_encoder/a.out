v000001A8117FE260_0 .var "Y", 1 0;
v000001A81183AB60_0 .var "valid", 0 0;
E_000001A811825200 .event anyedge, v000001A811840C20_0;
    .scope S_000001A811823F90;
T_0 ;
    %wait E_000001A811825200;
    %pushi/vec4 0, 0, 2;
