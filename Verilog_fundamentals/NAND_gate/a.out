#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_0000029BDA2F3C60 .scope module, "tb_nand_gate" "tb_nand_gate" 2 3;
 .timescale -9 -12;
v0000029BDA2F42F0_0 .var "a", 0 0;
v0000029BDA2CC340_0 .var "b", 0 0;
v0000029BDA2CC3E0_0 .net "out", 0 0, L_0000029BDA2F3B30;  1 drivers
S_0000029BDA2F40C0 .scope module, "uut" "nand_gate" 2 12, 3 1 0, S_0000029BDA2F3C60;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "out";
L_0000029BDA2F4390 .functor AND 1, v0000029BDA2F42F0_0, v0000029BDA2CC340_0, C4<1>, C4<1>;
L_0000029BDA2F3B30 .functor NOT 1, L_0000029BDA2F4390, C4<0>, C4<0>, C4<0>;
v0000029BDA2F3DF0_0 .net *"_ivl_0", 0 0, L_0000029BDA2F4390;  1 drivers
v0000029BDA307DE0_0 .net "a", 0 0, v0000029BDA2F42F0_0;  1 drivers
v0000029BDA2F3A90_0 .net "b", 0 0, v0000029BDA2CC340_0;  1 drivers
v0000029BDA2F4250_0 .net "out", 0 0, L_0000029BDA2F3B30;  alias, 1 drivers
    .scope S_0000029BDA2F3C60;
T_0 ;
    %vpi_call 2 20 "$monitor", "Time = %0t ns | Input A = %b | Input B = %b | Output OUT = %b", $time, v0000029BDA2F42F0_0, v0000029BDA2CC340_0, v0000029BDA2CC3E0_0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0000029BDA2F3C60;
T_1 ;
    %vpi_call 2 26 "$dumpfile", "nand_waveform.vcd" {0 0 0};
    %vpi_call 2 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0000029BDA2F3C60 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000029BDA2F42F0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000029BDA2CC340_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000029BDA2F42F0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000029BDA2CC340_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000029BDA2F42F0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000029BDA2CC340_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000029BDA2F42F0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000029BDA2CC340_0, 0, 1;
    %delay 10000, 0;
    %vpi_call 2 46 "$finish" {0 0 0};
    %end;
    .thread T_1;
