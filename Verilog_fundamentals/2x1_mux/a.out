#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
S_000001EFADEB4A50 .scope module, "mux_2x1_tb" "mux_2x1_tb" 2 3;
 .timescale -9 -12;
v000001EFADEC7C20_0 .var/i "i", 31 0;
v000001EFADEC7CC0_0 .var "i0", 0 0;
v000001EFADF0FD90_0 .var "i1", 0 0;
v000001EFADF0FCF0_0 .var "s", 0 0;
v000001EFADF0FF70_0 .net "y", 0 0, L_000001EFADF0FC50;  1 drivers
S_000001EFADEB4D70 .scope module, "dut" "mux_2x1" 2 12, 3 1 0, S_000001EFADEB4A50;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "i0";
    .port_info 1 /INPUT 1 "i1";
    .port_info 2 /INPUT 1 "s";
    .port_info 3 /OUTPUT 1 "y";
v000001EFADEB4F70_0 .net "i0", 0 0, v000001EFADEC7CC0_0;  1 drivers
v000001EFADEB4400_0 .net "i1", 0 0, v000001EFADF0FD90_0;  1 drivers
v000001EFADEC7AE0_0 .net "s", 0 0, v000001EFADF0FCF0_0;  1 drivers
v000001EFADEC7B80_0 .net "y", 0 0, L_000001EFADF0FC50;  alias, 1 drivers
L_000001EFADF0FC50 .functor MUXZ 1, v000001EFADEC7CC0_0, v000001EFADF0FD90_0, v000001EFADF0FCF0_0, C4<>;
    .scope S_000001EFADEB4A50;
T_0 ;
    %vpi_call 2 24 "$dumpfile", "mux_dump.vcd" {0 0 0};
    %vpi_call 2 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001EFADEB4A50 {0 0 0};
    %vpi_call 2 28 "$display", "Time\011 S \011 I1 \011 I0 \011 Y" {0 0 0};
    %vpi_call 2 29 "$display", "---------------------------------" {0 0 0};
    %vpi_call 2 30 "$monitor", "%0dns\011 %b \011 %b \011 %b \011 %b", $time, v000001EFADF0FCF0_0, v000001EFADF0FD90_0, v000001EFADEC7CC0_0, v000001EFADF0FF70_0 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v000001EFADEC7C20_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v000001EFADEC7C20_0;
    %cmpi/s 8, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %load/vec4 v000001EFADEC7C20_0;
    %pad/s 3;
    %split/vec4 1;
    %store/vec4 v000001EFADEC7CC0_0, 0, 1;
    %split/vec4 1;
    %store/vec4 v000001EFADF0FD90_0, 0, 1;
    %store/vec4 v000001EFADF0FCF0_0, 0, 1;
    %delay 10000, 0;
T_0.2 ; for-loop step statement
    %load/vec4 v000001EFADEC7C20_0;
    %addi 1, 0, 32;
    %store/vec4 v000001EFADEC7C20_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %vpi_call 2 39 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.v";
    "module.v";
