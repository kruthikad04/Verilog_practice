 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /INPUT 2 "shift";
    .port_info 2 /INPUT 1 "direction";
    .port_info 3 /OUTPUT 4 "result";
v000001B0A2ED3890_0 .net "data", 3 0, v000001B0A2EE8710_0;  1 drivers
v000001B0A2EAC200_0 .net "direction", 0 0, v000001B0A2EE87B0_0;  1 drivers
v000001B0A2EE85D0_0 .var "result", 3 0;
v000001B0A2EE8670_0 .net "shift", 1 0, v000001B0A2ED4FB0_0;  1 drivers
E_000001B0A2ED2DF0 .event anyedge, v000001B0A2EAC200_0, v000001B0A2ED3890_0, v000001B0A2EE8670_0;
    .scope S_000001B0A2EE8440;
T_0 ;
    %wait E_000001B0A2ED2DF0;
    %load/vec4 v000001B0A2EAC200_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v000001B0A2ED3890_0;
    %ix/getv 4, v000001B0A2EE8670_0;
    %shiftl 4;
    %store/vec4 v000001B0A2EE85D0_0, 0, 4;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v000001B0A2ED3890_0;
    %ix/getv 4, v000001B0A2EE8670_0;
    %shiftr 4;
    %store/vec4 v000001B0A2EE85D0_0, 0, 4;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_000001B0A2ED3700;
T_1 ;
    %vpi_call 2 22 "$dumpfile", "barrel_shifter.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_000001B0A2ED3700 {0 0 0};
    %vpi_call 2 25 "$monitor", "Time=%0t | Data=%b | Shift=%b | Direction=%b | Result=%b", $time, v000001B0A2EE8710_0, v000001B0A2ED4FB0_0, v000001B0A2EE87B0_0, v000001B0A2EE8850_0 {0 0 0};
    %pushi/vec4 11, 0, 4;
    %store/vec4 v000001B0A2EE8710_0, 0, 4;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v000001B0A2ED4FB0_0, 0, 2;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000001B0A2EE87B0_0, 0, 1;
