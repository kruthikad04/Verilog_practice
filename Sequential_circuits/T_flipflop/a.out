v000002691F9B9440_0 .var "Q", 0 0;
v000002691F9A4730_0 .net "T", 0 0, v000002691F97C3B0_0;  1 drivers
E_000002691F9BA8D0 .event posedge, v000002691F9A4690_0;
    .scope S_000002691F9A4500;
T_0 ;
    %wait E_000002691F9BA8D0;
    %load/vec4 v000002691F9A4730_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v000002691F9B9440_0;
    %assign/vec4 v000002691F9B9440_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v000002691F9B9440_0;
    %inv;
    %assign/vec4 v000002691F9B9440_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_000002691F9A4160;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v000002691F9A47D0_0, 0, 1;
T_1.0 ;
