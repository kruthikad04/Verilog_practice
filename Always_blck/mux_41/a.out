    %store/vec4 v000001B13B63C090_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v000001B13B63C090_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 3, 0, 2;
    %store/vec4 v000001B13B63C090_0, 0, 2;
    %delay 10000, 0;
    %pushi/vec4 13, 0, 4;
    %store/vec4 v000001B13B63BFF0_0, 0, 4;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v000001B13B63C090_0, 0, 2;
    %delay 10000, 0;
