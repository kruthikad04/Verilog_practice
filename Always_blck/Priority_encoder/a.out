 .timescale -9 -12;
v000001A811824120_0 .var "D", 3 0;
v000001A8118241C0_0 .net "Y", 1 0, v000001A8117FE260_0;  1 drivers
v000001A811824260_0 .net "valid", 0 0, v000001A81183AB60_0;  1 drivers
S_000001A811823F90 .scope module, "uut" "priority_encoder" 2 11, 3 1 0, S_000001A811840A90;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "D";
    .port_info 1 /OUTPUT 2 "Y";
